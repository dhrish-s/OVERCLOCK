{
  "name": "overclock-tracker",
  "productName": "Overclock",
  "version": "1.0.1",
  "description": "A local, offline daily execution console for grad-school + job-search grind: LeetCode, applications, system design study, and open source work, with timers, streaks, coins, and rewards.",
  "main": "main.js",
  "private": true,
  "author": "Dhrish",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/logic.test.mjs && node test/storage.test.cjs",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^42.11.8",
    "electron-builder": "^26.15.4"
  },
  "build": {
    "appId": "com.overclock.tracker",
    "productName": "Overclock",
    "copyright": "Copyright (c) 2026 Dhrish",
    "files": [
      "main.js",
      "preload.js",
      "storage.js",
      "src/**/*",
      "package.json",
      "LICENSE",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overclock"
    }
  }
}
